script = ExtResource("1_unitdef")
ability_lv2_name = "Charged Round"
ability_lv2_description = "Every third attack releases a charged round for 180% normal damage."
ability_lv3_name = "Target Lock"
ability_lv3_description = "Charged rounds mark the target for 2 seconds, increasing incoming damage by 20%. Marks refresh without stacking."
special_attack_min_level = 2
special_attack_every = 3
special_attack_hits = 1
special_attack_damage_mult = 1.8
special_attack_effect = "charged"
mark_min_level = 3
mark_damage_bonus = 0.2
mark_duration = 2.0
display_name = "Marksman"
type = 2
description = "Long-range sniper -- slow, fragile, devastating alpha strikes."
hp = 70.0
damage_per_hit = 29.0
attacks_per_second = 0.7407407
move_speed = 2.4
preferred_range = 11.0
retreat_range = 7.0
