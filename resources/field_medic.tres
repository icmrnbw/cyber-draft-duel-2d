[resource]
script = ExtResource("1_unitdef")
ability_lv2_name = "Aegis Dose"
ability_lv2_description = "Healing also adds a 3-second shield. Shields scale with the Medic's level and cap at 25% of the patient's maximum HP."
ability_lv3_name = "Trauma Reset"
ability_lv3_description = "Aegis Dose cleanses stagger, slow and suppression, then grants 0.75 seconds of control immunity."
heal_shield_min_level = 2
heal_shield_amount = 14.0
heal_shield_cap_fraction = 0.25
heal_shield_duration = 3.0
shield_cleanse_min_level = 3
control_immunity_duration = 0.75
display_name = "Field Medic"
type = 3
description = "Support -- heals the neediest ally, flees anyone who gets close, and can fire back at point-blank range if cornered."
hp = 85.0
damage_per_hit = 34.0
attacks_per_second = 1.3
splash_radius = 0.0
is_support = true
self_defense_damage = 7.0
self_defense_range = 3.0
move_speed = 4.1
preferred_range = 5.0
retreat_range = 4.0
sprite = ExtResource("2_sprite")
