[resource]
script = ExtResource("1_unitdef")
display_name = "Cryotek"
type = 1
description = "Cryo control specialist that slows enemies with every projector hit."
hp = 125.0
damage_per_hit = 18.0
attacks_per_second = 1.1
splash_radius = 1.8
move_speed = 2.6
preferred_range = 6.0
retreat_range = 3.0
ability_lv2_name = "Cryo Lock"
ability_lv2_description = "Projector hits slow enemies, making the front line easier to hold."
ability_lv3_name = "Thermal Collapse"
ability_lv3_description = "Every third projector burst carries a stronger slow and extra impact."
special_attack_min_level = 3
special_attack_every = 3
