[resource]
script = ExtResource("1_unitdef")
display_name = "ArcRelay"
type = 1
description = "Conductive mid-range disruptor whose attacks jump between nearby enemies."
hp = 105.0
damage_per_hit = 17.0
attacks_per_second = 1.25
move_speed = 3.0
preferred_range = 6.5
retreat_range = 3.5
ability_lv2_name = "Arc Chain"
ability_lv2_description = "Every fourth staff strike jumps to two nearby enemies for reduced damage."
ability_lv3_name = "Signal Jam"
ability_lv3_description = "Chained strikes briefly suppress the targets' outgoing damage."
special_attack_min_level = 2
special_attack_every = 4
special_attack_hits = 1
special_attack_damage_mult = 1.2
special_attack_effect = "chain"
special_chain_targets = 2
special_chain_damage_mult = 0.55
special_chain_radius = 3.5
suppression_min_level = 3
suppression_fraction = 0.2
suppression_duration = 1.4
