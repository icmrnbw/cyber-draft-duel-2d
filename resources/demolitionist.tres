[resource]
script = ExtResource("1_unitdef")
ability_lv2_name = "Firestorm"
ability_lv2_description = "Splash impacts leave burning ground for 3 seconds, damaging enemies inside."
ability_lv3_name = "Scorched Ground"
ability_lv3_description = "Burning ground slows enemies by 30%. The slow refreshes while inside and lasts 0.35 seconds after leaving; overlapping slows do not add."
firepatch_slow_min_level = 3
firepatch_slow_fraction = 0.3
firepatch_slow_duration = 0.35
display_name = "Demolitionist"
type = 2
description = "Splash-damage grenadier -- every hit blasts everyone near the impact."
hp = 90.0
damage_per_hit = 18.0
attacks_per_second = 0.6
splash_radius = 1.8
is_support = false
move_speed = 2.7
preferred_range = 9.0
retreat_range = 5.0
firepatch_min_level = 2
firepatch_dps = 12.0
firepatch_duration = 3.0
firepatch_radius = 1.8
