[resource]
script = ExtResource("1_unitdef")
display_name = "Nullbreaker"
type = 2
description = "Anti-shield lance hunter whose charged shots pierce protection and expose vulnerable cores."
hp = 85.0
damage_per_hit = 37.0
attacks_per_second = 0.55
move_speed = 2.1
preferred_range = 11.0
retreat_range = 5.5
ability_lv2_name = "Piercing Charge"
ability_lv2_description = "Every third shot deals 175% normal damage. 80% of that damage bypasses shields; the rest is absorbed normally."
ability_lv3_name = "Expose Core"
ability_lv3_description = "Charged rounds mark the target for 2.5 seconds, increasing incoming damage by 25%. Marks refresh without stacking."
special_attack_min_level = 2
special_attack_every = 3
special_attack_hits = 1
special_attack_damage_mult = 1.75
special_attack_effect = "pierce"
special_shield_bypass_fraction = 0.8
mark_min_level = 3
mark_damage_bonus = 0.25
mark_duration = 2.5
sprite = ExtResource("2_sprite")
