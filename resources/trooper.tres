[resource]
script = ExtResource("1_unitdef")
ability_lv2_name = "Burst Protocol"
ability_lv2_description = "Every fourth attack fires three rounds, each dealing 60% normal damage."
ability_lv3_name = "Suppressive Volley"
ability_lv3_description = "Burst hits reduce the target's outgoing attack damage by 25% for 1.2 seconds. Suppression refreshes without stacking."
special_attack_min_level = 2
special_attack_every = 4
special_attack_hits = 3
special_attack_damage_mult = 0.6
special_attack_effect = "burst"
suppression_min_level = 3
suppression_fraction = 0.25
suppression_duration = 1.2
display_name = "Trooper"
type = 1
description = "Mid-range kiter -- fastest on the board, backs off and chips away."
hp = 100.0
damage_per_hit = 9.0
attacks_per_second = 3.5
move_speed = 4.7
preferred_range = 6.0
retreat_range = 4.0
sprite = ExtResource("2_sprite")
