[resource]
script = ExtResource("1_unitdef")
display_name = "Enforcer"
type = 0
description = "Melee bruiser -- closes distance fast, hits hard on contact."
hp = 200.0
damage_per_hit = 22.0
attacks_per_second = 1.8181819
move_speed = 4.2
preferred_range = 1.5
retreat_range = 0.0
stagger_min_level = 2
stagger_chance = 0.35
stagger_duration = 0.6
berserk_min_level = 3
berserk_max_speed_mult = 0.6
ability_lv2_name = "Heavy Strikes"
ability_lv2_description = "Each landed hit has a 35% chance to stagger its target for 0.6 seconds, interrupting attacks and movement."
ability_lv3_name = "Berserk"
ability_lv3_description = "Missing health shortens attack intervals, reaching up to 40% shorter intervals near zero health."
